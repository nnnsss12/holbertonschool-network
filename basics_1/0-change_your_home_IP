#!/usr/bin/env bash
# Changes localhost and facebook.com mappings in /etc/hosts

HOSTS_FILE="/etc/hosts"
TEMP_FILE=$(mktemp)

if [ "$EUID" -ne 0 ]; then
    rm -f "$TEMP_FILE"
    exit 1
fi

awk '
{
    if ($1 == "127.0.0.1") {
        for (i = 2; i <= NF; i++) {
            if ($i == "localhost") {
                $1 = "127.0.0.2"
                break
            }
        }
    }

    if ($2 == "facebook.com") {
        next
    }

    print
}
' "$HOSTS_FILE" > "$TEMP_FILE"

if ! grep -qE '^[[:space:]]*127\.0\.0\.2[[:space:]]+localhost([[:space:]]|$)' "$TEMP_FILE"; then
    echo "127.0.0.2 localhost" >> "$TEMP_FILE"
fi

echo "8.8.8.8 facebook.com" >> "$TEMP_FILE"

cat "$TEMP_FILE" > "$HOSTS_FILE"
rm -f "$TEMP_FILE"
